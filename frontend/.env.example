# Leave unset locally to use Vite's proxy to the local backend on port 8787.
# Set this only for Vercel Preview to the development Render service origin.
VITE_API_BASE_URL=

# Supabase project used for Google Auth and per-user cloud backups.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key