GEMINI_API_KEYS=your_dev_key_1,your_dev_key_2,your_dev_key_3,your_dev_key_4
# Live-session lease limit per key. Keep the Render pool on a single instance unless shared state is added.
GEMINI_MAX_SESSIONS_PER_KEY=3
# Gemini RPD resets at midnight Pacific; override only if your project quota reset differs.
GEMINI_QUOTA_RESET_TZ=America/Los_Angeles
# Optional secret header for GET /api/keys/status and the push admin routes; unset disables them (404).
ADMIN_TOKEN=
# Web push (optional). Generate with: npm run push:keys -w backend
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your_account_email@example.com
MEMORY_SUMMARY_MODEL=gemini-3.6-flash
LIVE_MODEL_NAME=gemini-3.1-flash-live-preview
CLOUDFLARE_API_TOKEN=your_cloudflare_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
# Server-only Groq key for the Help chat (free tier). Report rewrites use Cloudflare above.
GROQ_API_KEY=
BRAVE_API_KEY=your_brave_key_here
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
PORT=8787
# Report emails via Resend (optional; leave blank to disable)
RESEND_API_KEY=
REPORT_EMAIL_TO=your_account_email@example.com
REPORT_EMAIL_FROM=Reading Companion <onboarding@resend.dev>
